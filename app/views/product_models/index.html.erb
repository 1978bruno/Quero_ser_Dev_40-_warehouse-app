<h1>Modelos de Produtos</h1>

<% if @product_model.any? %>

  <% @product_model.each do |pm| %>
    <div>
      <h2><%= pm.name %><h2>
      <dl>
        <dt>SKU</dt>
        <dd><%= pm.sku %></dd>
        <dt>fornecedor</dt>
        <dd><%= pm.supplier.brand_name %></dd>
      </dl>
    </div>
  <% end  %>
<% else %>
  <p> Nenhum modelo de produto cadastrado </p>
<% end %>