<%= form_with(model: @supplier) do |f| %>
  <div>
    <%= f.label :corp_name %>
    <%= f.text_field :corp_name %>
  </div>
  <div>
    <%= f.label :brand_name %>
    <%= f.text_field :brand_name %>
  </div>
  <div>
    <%= f.label :regist_number %>
    <%= f.text_field :regist_number %>
  </div>
  <div>
    <%= f.label :full_addr %>
    <%= f.text_field :full_addr %>
  </div>
  <div>
    <%= f.label :city %>
    <%= f.text_field :city %>
  </div>
  <div>
    <%= f.label :state %>
    <%= f.text_field :state %>
  </div>
  <div>
    <%= f.label :email %>
    <%= f.text_field :email %>
  </div>
  <div>
    <%= f.submit %>
  </div>


<% end %>